# Environment Variables for Lang'ata Auto Ops & Lead Ledger

# GEMINI_API_KEY: Optional server-side key for bounded AI intake classification & symptom summarization.
# Deterministic rules execute automatically even when GEMINI_API_KEY is absent.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical public URL for sitemap, robots.txt, and dashboard links in notifications.
APP_URL="https://ais-pre-twtq44m24dr3wmd7weyfa7-515141959120.europe-west2.run.app"

# SQLITE_DB_PATH: Path to persistent SQLite database file (defaults to ./data/langata_leads.sqlite).
SQLITE_DB_PATH="./data/langata_leads.sqlite"

# DATABASE_URL: Optional PostgreSQL connection string for managed cloud Postgres deployment.
DATABASE_URL=""

# STAFF CREDENTIALS (Override defaults in production environment variables)
OWNER_ACCESS_CODE="langata-owner-2026"
SECRETARY_ACCESS_CODE="langata-sec-2026"
MECHANIC_ACCESS_CODE="langata-mech-2026"
SESSION_SECRET="change-this-session-secret-in-production-langata-2026"

# SECRETARY NOTIFICATION WEBHOOK (Optional: Slack / Email / WhatsApp Business API webhook URL)
NOTIFICATION_WEBHOOK_URL=""
